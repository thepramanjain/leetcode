class Solution {
public:
    char findTheDifference(string s, string t) {
        sort(s.begin(), s.end());
        sort(t.begin(), t.end());

        int i = 0;
        while (i < s.length() && s[i] == t[i]) {
            i++;
        }
        return t[i];
    }
};


class Solution {
public:
   char findTheDifference(string s, string t) {
        int sum = 0;
        for (auto &c: t) sum+=c;
        for (auto &c: s) sum-=c;
        return (char)sum;
    }};

