class Solution {
public:
    int totalFruit(vector<int>& fruits) {
        int maxlen = 0;
        int fruit = 0;
        int n = fruits.size();

        for (int i = 0; i < n; i++) {
            set<int> st;
            for (int j = i; j < n; j++) {
                st.insert(fruits[j]);
                if (st.size() <= 2)
                    fruit = j - i + 1;
                maxlen = max(maxlen, fruit);
            }
        }
        return maxlen;
    }
};


