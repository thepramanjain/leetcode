BETTER Soln: (Using sliding window and 2- pointer approach)
TIME COMPLEXITY: O(n)
SPACE COMPLEXITY: O(1)

class Solution {
public:
    int totalFruit(vector<int>& fruits) {
        int maxlen = 0;
        int fruit = 0;
        int n = fruits.size();
        int left = 0;
        int right = 0;

        map<int, int> mpp;
        int k = 2;

        while (right < n) {
            mpp[fruits[right]]++; 

                while (mpp.size() > k) {
                    mpp[fruits[left]]--;

                if (mpp[fruits[left]] == 0) { 
                mpp.erase(fruits[left]);
                }

                left++;
                }
    
                maxlen = max(maxlen, right - left + 1);
        
            right++;
        }
        return maxlen;
    }
};
