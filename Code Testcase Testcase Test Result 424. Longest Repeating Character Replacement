BY BRUTE FORCE APPROACH

class Solution {
public:
    int characterReplacement(string s, int k) {
        unordered_map<char, int> hash;
        int maxlength = 0;
        int n = s.size();

        for (int i = 0; i < n; i++) {
            hash.clear();
            int maxFreq = 0;
            for (int j = i; j < n; j++) {
                hash[s[j]]++;
                 int len = (j - i +1 );

                maxFreq = max(maxFreq, hash[s[j]]);
                int changes = (len) - maxFreq;

                if (changes <= k) {
                    maxlength = max(maxlength, len);
                }
            }
        }
        return maxlength;
    }
};
