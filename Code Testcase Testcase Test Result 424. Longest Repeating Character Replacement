By SLIDING WINDOW AND 2 POINTER APPROACH

class Solution {
public:
    int characterReplacement(string s, int k) {
        unordered_map<char, int> hash;
        int maxlength = 0;
        int n = s.size();
        int maxfreq = 0;
        int r = 0;
        int l = 0;

        while (r < n) {
            hash[s[r]]++;

            maxfreq = max(maxfreq, hash[s[r]]);

            while ((r - l + 1) - maxfreq > k) {
                hash[s[l]]--;
                l++;
            }
            maxlength = max(maxlength, (r - l + 1));
            r++;
        }
        return maxlength;
    }
};
