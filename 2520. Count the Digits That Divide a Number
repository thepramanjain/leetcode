class Solution {
public:
    int countDigits(int nums) {
        int count = 0;
        int temp = nums;
        while(temp>0) {
            int val = temp % 10;
            if (temp != 0 && nums %val ==0 ){
            count++;
            }
                temp /= 10;
 
            }

    return count;
    }
    
};
