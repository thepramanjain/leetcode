class Solution {
public:
int largestRectangleArea(vector<int>& histo) {
    stack<int> st;
     int maxArea =0;
    int n = histo.size();

    for (int i = 0; i <= n; i++) {
        while (!st.empty() && (i == n || histo[st.top()] >= histo[i])) {
            int height = histo[st.top()];
            st.pop();

            int width;
            if (st.empty())
                width = i;
            else
                width = i - st.top() - 1;
      
            maxArea = max(maxArea, width * height);
        }

        st.push(i);
    }

    return maxArea;
}};
