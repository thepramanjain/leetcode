BRUTE FORCE APPROACH
Time Complexity: O(n^2)


class Solution {
public:
    int longestOnes(vector<int>& nums, int k) {
       
        int len = 0;
        int maxlen = 0;
        int n = nums.size();

        for (int i = 0 ; i < n; i++){
             int zeroes = 0;
            for (int j = i ; j < n; j++){
                if(nums[j] == 0) 
                    zeroes++;
                if (zeroes <= k){
                     len = j-i+1;
                     maxlen = max(maxlen , len); 
                }
                }
        }
        return maxlen;
    }
};

----------------------------------------------------------------------------------------------------------
OPTIMAL APPROACH
Time Complexity: O(n)

class Solution {
public:
    int longestOnes(vector<int>& nums, int k) {
       
        int len = 0;
        int maxlen = 0;
        int n = nums.size();
        int l = 0;
        int r = 0;
        int zeroes = 0;
        while (r < n){
            if (nums[r]== 0) zeroes ++;
            while(zeroes > k){
                if (nums[l]==0) zeroes--;
                l++;
            }
            if (zeroes <=k){
                len = r-l+1;
                maxlen = max(maxlen, len);
            }
            r++;
        }
        return maxlen;
    }

};



